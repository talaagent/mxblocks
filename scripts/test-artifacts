#!/usr/bin/env python3
"""Install the packed packages in a clean consumer and exercise their contracts."""
import json
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix="mxblocks-consumer-") as directory:
    consumer = Path(directory)
    (consumer / "package.json").write_text('{"name":"mxblocks-consumer-check","private":true,"type":"module"}\n')
    archives = []
    for name in ("element", "math"):
        version = json.loads((root / f"packages/mxblocks-{name}/package.json").read_text())["version"]
        archives.append(str(root / f"artifacts/talaagent-mxblocks-{name}-{version}.tgz"))
    subprocess.run(["npm", "install", "--ignore-scripts", "--no-audit", "--no-fund", *archives], cwd=consumer, check=True)
    subprocess.run(["node", "--input-type=module", "-e", '''
import { existsSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
const entry = fileURLToPath(import.meta.resolve('@talaagent/mxblocks-element/assets/mxblocks-rich.js'));
if (!existsSync(entry) || !existsSync(entry + '.map') || !readdirSync(join(dirname(entry), 'fonts')).some(n => n.endsWith('.woff2'))) {
  throw new Error('Element archive is missing deployment assets');
}
'''], cwd=consumer, check=True)
    result = subprocess.run([str(consumer / "node_modules/.bin/mxblocks-math"), "render", "--out", str(consumer / "formula.png"), "x^2"], cwd=consumer, check=True, text=True, capture_output=True)
    metadata = json.loads(result.stdout)
    png = (consumer / "formula.png").read_bytes()
    assert png.startswith(b"\x89PNG\r\n\x1a\n")
    assert metadata["mimetype"] == "image/png" and metadata["size"] == len(png)
    assert metadata["w"] > 0 and metadata["h"] > 0
print("Packed npm consumer: Element assets resolve; math CLI renders valid PNG + metadata")
